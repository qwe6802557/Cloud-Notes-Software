{
  "name": "my-electron-app",
  "version": "1.0.0",
  "buildNumber": 1,
  "private": true,
  "description": "Cloud Notes desktop client",
  "author": "Cloud Notes",
  "main": "electron/main.js",
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gemoji": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-medium-zoom": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "@bytemd/react": "^1.22.0",
    "antd": "^5.24.8",
    "axios": "^1.9.0",
    "bytemd": "^1.22.0",
    "compression-webpack-plugin": "^11.1.0",
    "concurrently": "^9.1.2",
    "cra-template": "1.2.0",
    "cross-env": "^7.0.3",
    "diff": "^4.0.2",
    "highlight.js": "^11.8.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "wait-on": "^8.0.1",
    "web-vitals": "^4.2.4",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "node scripts/pack-win.js",
    "electron-pack:dir": "node scripts/pack-win.js --dir",
    "generate-assets": "node scripts/generate-assets.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "extends": null,
    "appId": "com.jiongren.cloudnotes",
    "productName": "Cloud Notes",
    "asar": true,
    "extraMetadata": {
      "main": "electron/main.js",
      "buildNumber": 1
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!build/**/*.map",
      "!build/**/*.gz",
      "!node_modules/**/*",
      "!**/node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "artifactName": "CloudNotes-Setup-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cloud Notes",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerHeader": "assets/installerHeader.bmp",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/uninstallerSidebar.bmp"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "craco-less": "^3.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "less": "^4.3.0",
    "less-loader": "^12.2.0"
  }
}
