# ===== 服务配置 =====
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# ===== 数据库 =====
MONGODB_URI=mongodb://localhost:27017/cloud_note

# ===== 安全密钥（生产环境必须替换为高强度随机值，启动时会强制校验）=====
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=替换为64字节以上的随机Base64字符串
JWT_EXPIRES_IN=7d
SESSION_KEY=替换为64字节以上的随机Base64字符串

# ===== 阿里云邮件推送 =====
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_REGION=cn-hangzhou
ALIYUN_FROM_EMAIL=noreply@yourdomain.com
ALIYUN_FROM_NAME=囧人云笔记
ALIYUN_REPLY_EMAIL=support@yourdomain.com
ALIYUN_DM_CONNECT_TIMEOUT_MS=5000
ALIYUN_DM_READ_TIMEOUT_MS=15000
ALIYUN_DM_MAX_ATTEMPTS=2

# ===== 文件上传 =====
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# ===== 接口限流 =====
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
VERIFY_CODE_RATE_LIMIT_WINDOW_MS=3600000
VERIFY_CODE_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20
