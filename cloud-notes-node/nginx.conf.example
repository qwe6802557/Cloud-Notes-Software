server {
    listen 80;
    server_name notes.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name notes.example.com;

    root /var/www/cloud-notes/front;
    index index.html;

    client_max_body_size 5m;

    ssl_certificate /etc/nginx/ssl/notes.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/notes.example.com.key;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /auth/ {
        proxy_pass http://127.0.0.1:3001/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /notes/ {
        proxy_pass http://127.0.0.1:3001/notes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /notebooks/ {
        proxy_pass http://127.0.0.1:3001/notebooks/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /uploads/notes {
        proxy_pass http://127.0.0.1:3001/uploads/notes;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        alias /var/lib/cloud-notes/uploads/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }
}
